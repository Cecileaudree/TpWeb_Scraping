{
  "target": {
    "base_url": "https://www.aucklandmuseum.com",
    "start_page": "samples/sample_page.html",
    "item_selector": ".collection-item",
    "fields": {
      "title": ".item-title",
      "url": ".item-link",
      "category": ".item-category",
      "date_text": ".item-date"
    }
  },
  "export": {
    "output_path": "samples/sample_output.json",
    "format": "json"
  },
  "scrape": {
    "delay_seconds": 30.0,
    "max_items": 20,
    "sample_mode": true
  }
}
